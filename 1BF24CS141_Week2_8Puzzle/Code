import time
import tracemalloc

# Generate all possible moves
def generate_moves(state):
    moves = []
    puzzle = list(state)
    blank = puzzle.index(0)
    row = blank // 3
    col = blank % 3

    # UP
    if row > 0:
        new_puzzle = puzzle.copy()
        new_puzzle[blank], new_puzzle[blank - 3] = new_puzzle[blank - 3], new_puzzle[blank]
        moves.append(tuple(new_puzzle))
    # DOWN
    if row < 2:
        new_puzzle = puzzle.copy()
        new_puzzle[blank], new_puzzle[blank + 3] = new_puzzle[blank + 3], new_puzzle[blank]
        moves.append(tuple(new_puzzle))
    # LEFT
    if col > 0:
        new_puzzle = puzzle.copy()
        new_puzzle[blank], new_puzzle[blank - 1] = new_puzzle[blank - 1], new_puzzle[blank]
        moves.append(tuple(new_puzzle))
    # RIGHT
    if col < 2:
        new_puzzle = puzzle.copy()
        new_puzzle[blank], new_puzzle[blank + 1] = new_puzzle[blank + 1], new_puzzle[blank]
        moves.append(tuple(new_puzzle))
        
    return moves

# Depth-First Search (DFS) - Corrected State Counting
def DFS(start_state, goal_state):
    stack = [start_state]
    visited = set()

    while stack:
        current_state = stack.pop()

        if current_state not in visited:
            visited.add(current_state)  # Mark visited immediately upon evaluation

            if current_state == goal_state:
                return "Goal Found", len(visited)

            next_states = generate_moves(current_state)
            
            for next_state in next_states:
                if next_state not in visited:
                    stack.append(next_state)
                    
    return "Goal Not Found", len(visited)

# Function to take 3x3 matrix input
def input_matrix(name):
    print(f"\nEnter {name} (3 x 3 matrix, space-separated numbers):")
    matrix = []
    for i in range(3):
        row = list(map(int, input(f"Enter row {i + 1}: ").split()))
        if len(row) != 3:
            print("Error: Enter exactly 3 numbers in each row.")
            exit()
        matrix.append(row)
    return tuple(num for row in matrix for num in row)

# Function to display matrix
def display_matrix(state):
    for i in range(0, 9, 3):
        print(" ".join(map(str, state[i:i + 3])))

# ---------------- MAIN PROGRAM ----------------
if __name__ == "__main__":
    print("Enter 0 for the blank space.")
    
    start = input_matrix("Initial State")
    goal = input_matrix("Goal State")

    if set(start) != set(range(9)) or set(goal) != set(range(9)):
        print("\nError: Matrix must contain numbers 0 to 8 exactly once.")
        exit()

    print("\nInitial State:")
    display_matrix(start)
    print("\nGoal State:")
    display_matrix(goal)

    # Start profiling
    tracemalloc.start()
    start_time = time.perf_counter()

    result, visited_count = DFS(start, goal)

    end_time = time.perf_counter()
    current_memory, peak_memory = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    # Output Results
    print("\n" + "="*30)
    print("Result:", result)
    print("Unique States Visited:", visited_count)
    print("Execution Time: {:.6f} seconds".format(end_time - start_time))
    print("Peak Memory Used: {:.2f} KB".format(peak_memory / 1024))
    print("="*30)
    print("\nTheoretical Complexity:")
    print("Time Complexity : O(b^m) where m is the maximum depth of the state space")
    print("Space Complexity : O(V) due to tracking unique states in the visited set")
