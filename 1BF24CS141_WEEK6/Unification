
# Unification in First Order Logic

def is_variable(x):
    return isinstance(x, str) and x.islower()

def occurs(var, expr, subst):
    expr = substitute(expr, subst)

    if var == expr:
        return True

    if isinstance(expr, tuple):
        return any(occurs(var, arg, subst) for arg in expr[1:])

    return False

def substitute(expr, subst):
    if isinstance(expr, str) and expr in subst:
        return substitute(subst[expr], subst)

    if isinstance(expr, tuple):
        return (expr[0],) + tuple(
            substitute(arg, subst) for arg in expr[1:]
        )

    return expr

def unify(x, y, subst):
    x = substitute(x, subst)
    y = substitute(y, subst)

    if x == y:
        return subst

    if is_variable(x):
        if occurs(x, y, subst):
            raise ValueError("Occurs check failed")
        subst[x] = y
        return subst

    if is_variable(y):
        if occurs(y, x, subst):
            raise ValueError("Occurs check failed")
        subst[y] = x
        return subst

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x) != len(y):
            raise ValueError("Predicate or arity mismatch")

        for a, b in zip(x[1:], y[1:]):
            unify(a, b, subst)

        return subst

    raise ValueError("Unification failed")

